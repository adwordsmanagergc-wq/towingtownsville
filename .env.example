# Public site URL (no trailing slash) — used for canonicals, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://townsvilletowingcompare.com.au

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# Resend transactional email (https://resend.com)
RESEND_API_KEY=
OWNER_EMAIL=owner@example.com

# Optional: Google Search Console verification meta token
NEXT_PUBLIC_GSC_VERIFICATION=
